# syntax=docker/dockerfile:1.7

# Stage 1: Asset preparation and dependency pruning (Full-Stack: Backend + Frontend)
FROM node:22-bookworm-slim AS assets
WORKDIR /app

# Copy backend server distribution (contains dist, node_modules, schema.prisma, scripts)
COPY ./packages/backend/server /app

# Copy compiled Frontend static distributions served by StaticFilesResolver on port 3010
COPY ./packages/frontend/apps/web/dist /app/static
COPY ./packages/frontend/admin/dist /app/static/admin
COPY ./packages/frontend/apps/mobile/dist /app/static/mobile

ARG TARGETARCH
ARG TARGETVARIANT

# Required for Prisma engine resolution during cleanup
RUN apt-get update && \
  apt-get install -y --no-install-recommends openssl ca-certificates && \
  rm -rf /var/lib/apt/lists/*

# Symlink /node_modules -> /app/node_modules for schema.prisma output (../../../node_modules/.prisma/client),
# restore executable permissions stripped by artifact upload, and ensure Prisma Client is generated
RUN ln -s /app/node_modules /node_modules && \
  mkdir -p /app/node_modules/.bin && \
  ln -sf ../prisma/build/index.js /app/node_modules/.bin/prisma && \
  chmod -R +x /app/node_modules/.bin /app/node_modules/@prisma/engines /app/node_modules/prisma/build 2>/dev/null || true && \
  node ./node_modules/prisma/build/index.js generate

# Clean sourcemaps, deduplicate static assets, and prune foreign architecture binaries
RUN AFFINE_DOCKER_CLEAN=1 TARGETARCH="${TARGETARCH}" TARGETVARIANT="${TARGETVARIANT}" node ./scripts/docker-clean.mjs

# Stage 2: Runtime image (All-in-One Backend + Frontend)
FROM node:22-bookworm-slim
WORKDIR /app

COPY --from=assets /app /app

# Install runtime dependencies: openssl, jemalloc, curl (for healthcheck), and symlink /node_modules
RUN apt-get update && \
  apt-get install -y --no-install-recommends openssl libjemalloc2 curl && \
  rm -rf /var/lib/apt/lists/* && \
  ln -s /app/node_modules /node_modules

# Optimize memory usage with jemalloc
ENV LD_PRELOAD=libjemalloc.so.2
ENV NODE_ENV=production
ENV DEPLOYMENT_TYPE=selfhosted
ENV PORT=3010

EXPOSE 3010

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3010/info || exit 1

# Start server: upgrade config & boot main NestJS app (serves both API & Frontend static files)
CMD ["sh", "-c", "node ./scripts/upgrade-config.js && exec node ./dist/main.js"]
